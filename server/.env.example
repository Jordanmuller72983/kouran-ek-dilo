# Copy to .env and fill in. Everything is optional in development.

PORT=4000
# Where the SQLite DB and generated secrets live
DATA_DIR=data
# Public URL of the web app, used in notification links
PUBLIC_URL=http://localhost:5173

# Admin moderation token. If empty, one is generated and printed on startup.
ADMIN_TOKEN=

# Background jobs
JOBS_ENABLED=true
INGEST_EVERY_MINUTES=30
DISPATCH_EVERY_SECONDS=60

# Set to 1 when running behind a reverse proxy (Render, Fly, nginx...)
TRUST_PROXY=

# Web push (VAPID). If empty, keys are generated and stored in DATA_DIR/secrets.json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.mu

# Twilio for SMS + WhatsApp. If empty, messages are printed to the console instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
# e.g. whatsapp:+14155238886 (Twilio sandbox) or your approved WhatsApp sender
TWILIO_WHATSAPP_FROM=
